# LAB ERP ayarları. Bu dosyayı ".env" adıyla kopyalayın ve değerleri değiştirin.
#   Linux:   cp .env.example .env
#   Windows: copy .env.example .env

# Tarayıcıdan erişilecek port (http://SUNUCU_IP:80)
ERP_HTTP_PORT=80

# Veritabanı (ilk kurulumdan sonra şifreyi değiştirmeyin; değiştirirseniz veritabanında da değiştirin)
POSTGRES_USER=erp
POSTGRES_PASSWORD=degistir-bunu-guclu-bir-sifre
POSTGRES_DB=erp

# Oturum anahtarı: uzun ve rastgele olmalı (ör. openssl rand -hex 32)
ERP_JWT_SECRET=degistir-bunu-uzun-rastgele-bir-anahtar

# İlk açılışta oluşturulan yönetici (ilk girişten sonra şifreyi uygulamadan değiştirin)
ERP_ADMIN_USER=admin
ERP_ADMIN_PASSWORD=admin

# Yedekleme: her gün bu saatte (HH:MM), son N gün saklanır
ERP_BACKUP_TIME=02:00
ERP_BACKUP_KEEP_DAYS=14
# Yedeklerin yazılacağı yer: Docker volume adı (varsayılan) veya sunucuda bir klasör yolu
# ör. Linux: /srv/erp-yedek   Windows: D:/ERP-Yedek
ERP_BACKUP_PATH=erpbackups

# En büyük yükleme boyutu (MB)
ERP_MAX_UPLOAD_MB=2048

# Güncelleme bildirimi için yerel ağdaki sürüm dosyası adresi (boş: kapalı)
ERP_UPDATE_FEED_URL=

# Saat dilimi
TZ=Europe/Istanbul

# İmaj adları ve sürüm etiketi (offline kurulumda dışa aktarılan imajlarla aynı olmalı)
ERP_IMAGE_PREFIX=parca-takip
ERP_TAG=latest
