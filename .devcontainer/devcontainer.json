// GitHub Codespaces demo: the Docker-free mode (SQLite, one process) with the demo projects.
// README "Codespaces'te aç" link -> https://codespaces.new/serdevir91/parca-takip-erp?quickstart=1
{
  "name": "Parça Takip ERP (demo)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" }
  },
  "containerEnv": {
    "ERP_DATABASE_URL": "sqlite:///${containerWorkspaceFolder}/.demo/erp.db",
    "ERP_DATA_DIR": "${containerWorkspaceFolder}/.demo/data",
    "ERP_BACKUP_DIR": "${containerWorkspaceFolder}/.demo/yedek",
    "ERP_JWT_SECRET": "codespaces-demo-only",
    "ERP_ADMIN_USER": "admin",
    "ERP_ADMIN_PASSWORD": "admin",
    "TZ": "Europe/Istanbul"
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Parça Takip ERP", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] }
  }
}
